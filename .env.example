# Polymarket CLOB credentials (blank = dry-run). Generate with:
#   python -m hightempbot.cli.derive_poly_creds
POLY_PRIVATE_KEY=your_wallet_private_key_here
POLY_API_KEY=your_clob_api_key_here
POLY_SECRET=your_clob_api_secret_here
POLY_PASSPHRASE=your_clob_passphrase_here

# Wallet type: 0 EOA, 1 proxy, 2 Safe, 3 deposit wallet (needs POLY_FUNDER).
# Deposit wallets must use 3. Check with derive_poly_creds --probe-balance.
POLY_SIGNATURE_TYPE=0
POLY_FUNDER=

# Relayer (deploys deposit wallets, submits transfers)
RELAYER_URL=https://relayer-v2.polymarket.com
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=

# Live readiness / wallet reconciliation (keep local and server .env in sync)
POLYGON_RPC_URL=https://polygon-rpc.com
POLY_RETURN_WALLET=
LIVE_READINESS_REQUIRED=True
LIVE_REQUIRE_DEPOSIT_WALLET=True
LIVE_ONCHAIN_VERIFY_ENABLED=True
LIVE_BALANCE_TOLERANCE_USD=0.25
LIVE_READINESS_CACHE_TTL_S=120
WALLET_SNAPSHOT_FRESHNESS_TTL_S=900
WALLET_SNAPSHOT_INTERVAL_MINUTES=10
OPERATOR_ACTION_FRESHNESS_TTL_S=300
AUTO_REDEEM_ENABLED=True
AUTO_REDEEM_INTERVAL_MINUTES=10

# Trading
DRY_RUN=True
INITIAL_BANKROLL=100
# Swap NO for the FLIP experiment (restart to apply)
FLIP_MODE=False

DB_PATH=data/hightempbot.db
DATA_DIR=data
LOG_LEVEL=INFO

# Public key used by wunderground.com itself
WU_API_KEY=e1f10a1e78da46f5b10a1e78da96f525

# Dashboard. A password makes it bind 0.0.0.0 unless DASHBOARD_BIND_HOST is set.
# Keep comments on their own line: dotenv reads "KEY=   # note" as the value.
DASHBOARD_PORT=8080
DASHBOARD_USER=admin
DASHBOARD_PASS=
DASHBOARD_BIND_HOST=
# True when a reverse proxy terminates TLS
DASHBOARD_TLS_TERMINATED=False

# Telegram alerts (optional)
NOTIFY_TELEGRAM_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=

# polymarketdata.co, backtests only
POLYMARKETDATA_API_KEY=your_polymarketdata_api_key_here

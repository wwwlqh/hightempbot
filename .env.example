# Polymarket CLOB credentials (required for live trading, leave blank for dry-run)
# Get via: python -m hightempbot.cli.derive_poly_creds
POLY_PRIVATE_KEY=your_wallet_private_key_here
POLY_API_KEY=your_clob_api_key_here
POLY_SECRET=your_clob_api_secret_here
POLY_PASSPHRASE=your_clob_passphrase_here

# Polymarket wallet topology.
#   POLY_SIGNATURE_TYPE:
#     0 = EOA (funds at the private-key signer; default)
#     1 = POLY_PROXY (legacy proxy wallet; normally leave POLY_FUNDER blank)
#     2 = POLY_GNOSIS_SAFE (Safe wallet; set POLY_FUNDER if not auto-derived)
#     3 = POLY_1271 (deposit wallet flow for new API users; POLY_FUNDER required)
# Polymarket rejects deposit-wallet orders with "maker address not allowed" if
# you use signature_type=1/2 instead of 3.
# Probe with:
#   python -m hightempbot.cli.derive_poly_creds --signature-type 3 --funder 0x... --sync-balance --probe-balance
# Diagnose/deploy the deposit wallet with:
#   python -m hightempbot.cli.poly_wallet_diagnostics --check-relayer --probe-clob
POLY_SIGNATURE_TYPE=0
POLY_FUNDER=

# Polymarket relayer credentials (required to deploy deposit wallets and submit
# deposit-wallet approval/transfer batches; separate from CLOB L2 credentials)
RELAYER_URL=https://relayer-v2.polymarket.com
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=

# Live readiness / wallet reconciliation. Local .env and server .env are
# separate files, but these live-critical values should match before go-live.
POLYGON_RPC_URL=https://polygon-rpc.com
POLY_RETURN_WALLET=
LIVE_READINESS_REQUIRED=True
LIVE_REQUIRE_DEPOSIT_WALLET=True
LIVE_ONCHAIN_VERIFY_ENABLED=True
LIVE_BALANCE_TOLERANCE_USD=0.25
LIVE_READINESS_CACHE_TTL_S=120
WALLET_SNAPSHOT_FRESHNESS_TTL_S=900
WALLET_SNAPSHOT_INTERVAL_MINUTES=10
OPERATOR_ACTION_FRESHNESS_TTL_S=300
AUTO_REDEEM_ENABLED=True
AUTO_REDEEM_INTERVAL_MINUTES=10

# Trading mode
DRY_RUN=True                  # True = paper trading (log signals, no real orders)
INITIAL_BANKROLL=100          # Starting capital in USD
FLIP_MODE=False               # True = FLIP experiment: NO sleeve off, FLIP (YES where NO gate fires) on; restart to apply

# Database & data
DB_PATH=data/hightempbot.db
DATA_DIR=data

# Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Weather Underground - public widget apiKey (no signup; same key wunderground.com's web frontend uses).
# Required for daily actuals ingestion via api.weather.com/v1. If a future restriction breaks this key,
# extract a fresh one from any wunderground.com page's DevTools -> Network -> api.weather.com request.
WU_API_KEY=e1f10a1e78da46f5b10a1e78da96f525

# Dashboard
DASHBOARD_PORT=8080
DASHBOARD_USER=admin
# Set a password to enable public access (binds 0.0.0.0); blank = localhost only (SSH tunnel).
# Keep comments on their own line: python-dotenv reads "KEY=   # note" as the value "# note".
DASHBOARD_PASS=
# Explicit bind host (e.g. 127.0.0.1 or 0.0.0.0); blank = legacy fallback via DASHBOARD_PASS above
DASHBOARD_BIND_HOST=
DASHBOARD_TLS_TERMINATED=False    # True when a reverse proxy (nginx/Caddy) terminates TLS in front of the dashboard

# Push notifications (optional - both are silently skipped if blank)
# BotFather token
NOTIFY_TELEGRAM_TOKEN=
# Chat/user ID to send alerts to
NOTIFY_TELEGRAM_CHAT_ID=

# PolymarketData.co - historical data API for backtesting only (not used by live bot)
# Get key at https://app.polymarketdata.co/settings/api-keys
POLYMARKETDATA_API_KEY=your_polymarketdata_api_key_here
